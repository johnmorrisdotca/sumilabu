.venv-tools/
__pycache__/
*.pyc
*.mpy
.DS_Store

# Local secrets (use secrets.py.example as template)
secrets.py
firmware/secrets.py

# Generic env files
.env
.env.*

# Keep example templates commit-able
!**/.env.example

# MagTag Wi-Fi and calendar settings, written to the board by deploy_magtag.sh
firmware/magtag/settings.toml

# Board images: re-downloadable (uf2/) or this machine's own backups (factory/), megabytes each
firmware/uf2/*.uf2
firmware/uf2/*.bin
firmware/magtag/factory/*.uf2
firmware/magtag/factory/*.bin
