generator client {
  provider = "prisma-client-js"
  /*
   * THE ENGINE THE SITE ACTUALLY RUNS ON, named because the client is no
   * longer generated where it runs.
   *
   * Prisma ships a native query engine per platform, and `prisma generate`
   * builds only the one for the machine it runs on unless it is told
   * otherwise. That was invisible while the dashboard shipped by somebody
   * running `vercel deploy --prod` from sumilabu-dashboard/: Vercel built the
   * project itself, so generate ran in Vercel's own container and produced the
   * engine Vercel runs.
   *
   * The deploy workflow builds on a GitHub runner and uploads the result with
   * `vercel deploy --prebuilt`, so generate now runs on Ubuntu and produces
   * debian-openssl-3.0.x, while the function runs on Amazon Linux and wants
   * rhel-openssl-3.0.x. Prisma then throws the moment it is asked for a
   * connection.
   *
   * WHAT THAT LOOKS LIKE, because it cost an afternoon: every route that
   * touches the database answers 500 with an EMPTY BODY, and every route that
   * does not is perfectly fine. /api/v1/projects reads its answer from the
   * token config and kept returning 200, the deploy's own smoke check reads
   * /api/openapi.json and passed, every CI step was green — and the board was
   * unreadable for four sites at once.
   *
   * `native` stays for developers and for the test run in CI; the second entry
   * is the one the deployment needs. Both, not one: a list with only rhel in it
   * breaks every laptop.
   */
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Device {
  id          String        @id @default(cuid())
  projectKey  String        @default("default")
  deviceId    String
  displayName String?
  appVersion  String?
  lastMode    String?
  lastSeenAt  DateTime?
  /// The heartbeat interval the device last reported (`heartbeat_interval_s`
  /// on /api/device-stats), in seconds. Null until it reports one, and the
  /// dashboard then judges it by EXPECTED_HEARTBEAT_SECONDS/STALE_AFTER_SECONDS.
  heartbeatIntervalSeconds Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  events      DeviceEvent[]

  @@unique([projectKey, deviceId])
  @@index([projectKey, lastSeenAt(sort: Desc)])
  @@index([lastSeenAt(sort: Desc)])
}

model DeviceEvent {
  id             String   @id @default(cuid())
  projectKey     String   @default("default")
  deviceId       String
  deviceRefId    String
  event          String
  mode           String?
  ntpOk          Boolean?
  bitmapAssetsOk Boolean?
  memFree        Int?
  memAlloc       Int?
  uptimeS        Int?
  unixTs         Int?
  wifi           String?
  sync           String?
  appVersion     String?
  raw            Json?
  receivedAt     DateTime @default(now())

  device Device @relation(fields: [deviceRefId], references: [id], onDelete: Cascade)

  @@index([projectKey, receivedAt(sort: Desc)])
  @@index([deviceId, receivedAt(sort: Desc)])
  @@index([receivedAt(sort: Desc)])
}

model AppTelemetrySource {
  id           String              @id @default(cuid())
  projectKey   String              @default("default")
  sourceType   String              @default("app")
  appId        String
  displayName  String?
  environment  String              @default("default")
  host         String?
  service      String?
  lastEvent    String?
  lastStatus   String?
  lastSeverity String?
  lastMessage  String?
  lastSeenAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  events       AppTelemetryEvent[]

  @@unique([projectKey, sourceType, appId, environment])
  @@index([projectKey, appId])
  @@index([projectKey, sourceType])
  @@index([projectKey, service])
  @@index([projectKey, lastStatus])
  @@index([projectKey, lastSeverity])
  @@index([lastSeenAt(sort: Desc)])
}

model AppTelemetryEvent {
  id          String    @id @default(cuid())
  projectKey  String    @default("default")
  sourceType  String    @default("app")
  appId       String
  sourceRefId String
  environment String    @default("default")
  host        String?
  service     String?
  event       String
  status      String?
  severity    String?
  message     String?
  durationMs  Int?
  metricName  String?
  metricValue Float?
  metricUnit  String?
  tags        Json?
  metrics     Json?
  server      Json?
  telemetry   Json?
  raw         Json?
  occurredAt  DateTime?
  receivedAt  DateTime  @default(now())

  source AppTelemetrySource @relation(fields: [sourceRefId], references: [id], onDelete: Cascade)

  @@index([projectKey, receivedAt(sort: Desc)])
  @@index([projectKey, appId, receivedAt(sort: Desc)])
  @@index([projectKey, sourceType, receivedAt(sort: Desc)])
  @@index([projectKey, service, receivedAt(sort: Desc)])
  @@index([projectKey, status, receivedAt(sort: Desc)])
  @@index([projectKey, severity, receivedAt(sort: Desc)])
  @@index([receivedAt(sort: Desc)])
}

/// One ticket on any site's board.
///
/// The board contract (docs/board/BOARD_RULES.md, identical in every client
/// repository) is enforced here once, so UmaKuma's `pnpm task` and Itsutsu's
/// backlog stop carrying their own copies of the lease, the move table and
/// the caps. Canonical vocabulary on every row: status is open, inProgress,
/// done or dropped; kind is feature, fix or chore; priority high, normal, low;
/// effort small, medium, large. A client maps to its own words at its edge.
///
/// Caps are here as well as in code, because a cap that lives only in
/// TypeScript is another door.
model BoardTicket {
  id         String    @id @default(cuid())
  projectKey String    @default("default")
  /// A client's citable name, as Itsutsu cites `its-xp-history`: a kebab
  /// slug, unique within the project, written once at create or import and
  /// never changed. Null for a client that cites the id, as UmaKuma does.
  key        String?   @db.VarChar(80)
  title      String    @db.VarChar(120)
  detail     String?   @db.VarChar(4000)
  /// Per project; a project with no areas leaves it null.
  area       String?
  kind       String    @default("feature")
  status     String    @default("open")
  /// Null until somebody grades the row. No default on purpose.
  priority   String?
  effort     String?
  askedBy    String?   @db.VarChar(60)
  /// Who holds it and since when. inProgress means exactly "claimedBy is set
  /// and the hold is inside the six-hour lease" - no writer sets status
  /// without writing these the same way.
  claimedBy  String?   @db.VarChar(80)
  claimedAt  DateTime?
  /// Written by a release tool only, together with `done`.
  releasedIn    String?   @db.VarChar(40)
  /// The client's own release record id (UmaKuma's timeline entry), which is
  /// what its unship check looks for on origin/main - a version alone is not
  /// enough, since two entries can share a push.
  releasedEntry String?   @db.VarChar(120)
  releasedAt    DateTime?
  /// Who last revised the title or detail, and when. A move or a grade is not
  /// a revision and writes neither.
  editedBy   String?   @db.VarChar(80)
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  /// Changes only on a status move. Grading is not movement.
  movedAt    DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// Postgres treats nulls as distinct, so any number of unkeyed rows coexist.
  @@unique([projectKey, key])
  @@index([projectKey, status, movedAt(sort: Desc)])
  @@index([projectKey, claimedBy])
  @@index([projectKey, createdAt(sort: Desc)])
}

/// A key/value setting for one project - signup mode, a feature flag.
model BoardSetting {
  projectKey String
  key        String   @db.VarChar(80)
  value      String   @db.VarChar(4000)
  /// Who last wrote it, for the log that answers "who changed this".
  setBy      String?  @db.VarChar(80)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([projectKey, key])
}

