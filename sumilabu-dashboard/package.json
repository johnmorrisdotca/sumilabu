{
  "name": "sumilabu-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-6500}",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-6500}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:drift": "prisma migrate diff --from-url \"$DIRECT_URL\" --to-schema-datamodel prisma/schema.prisma --script",
    "db:studio": "prisma studio",
    "deploy:prune": "bash scripts/prune-deployments.sh",
    "functions:size": "node scripts/check-function-sizes.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
